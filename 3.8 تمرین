#include <iostream>
using namespace std;
int main()
{
	int a,b;
	char op;
	cin >> a >> b >> op;
	{
		switch(op)
		case '+':
		cout << a+b << endl;
		break;
		case '-':
		cout << a-b << endl;
		break;
		case '*':
		cout << a*b << endl;
		break;
		case '/':
		if (b != 0) 
		cout << a / b << endl;
		else
		cout <<"error: Division by zero" << endl;
		break;
		case '%':
			if(b !=0)
			cout << a%b << endl;
			else
			cout <<"error: Division by zero" << endl;
			break;
			default:
				cout <<"invalid operator" << endl;
	}
}
